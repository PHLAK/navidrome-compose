# ------------------------------------------------------------------------------
# Navidrome version override. Update this value and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# NAVIDROME_VERSION=latest

# ------------------------------------------------------------------------------
# The Navidrome server port to be exposed to the host.
# ------------------------------------------------------------------------------

# NAVIDROME_PORT=4533
# AUDIOMUSE_PORT=8000

# ------------------------------------------------------------------------------
# Path to your top-level music directory. This path can be absolute or relative
# to the 'docker-compose.yaml' file.
# ------------------------------------------------------------------------------

MUSIC_PATH=

# ------------------------------------------------------------------------------
# Path where backups will be stored. This path can be absolute or relative to
# the 'docker-compose.yaml' file.
# ------------------------------------------------------------------------------

# BACKUPS_PATH=./backups

# ------------------------------------------------------------------------------
# Navidrome data volume. Absolue or relative path on the host or a named Docker
# volume. Defaults to an internal docker volume.
# ------------------------------------------------------------------------------

# NAVIDROME_DATA_VOLUME=navidrome-data

# ------------------------------------------------------------------------------
# The database configuration. Only the password is required when using the
# provided 'postgres' container.
# ------------------------------------------------------------------------------

# DATABASE_HOST=database
# DATABASE_NAME=audiomuse
# DATABASE_USER=audiomuse
DATABASE_PASSWORD=

# ------------------------------------------------------------------------------
# Database volume. Absolue or relative path on the host or a named Docker
# volume. Defaults to an internal docker volume.
# ------------------------------------------------------------------------------

# DATABASE_VOLUME=postgres-data
